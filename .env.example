# Copy to .env and fill in only what you need. .env is never committed or backed up.

# Where the library, database, client files and backups are stored (default: ./data)
NAV_DATA_DIR=./data

# Server address. Keep 127.0.0.1 (this computer only) unless you need tablet access.
NAV_HOST=127.0.0.1
NAV_PORT=8000
# Required if NAV_HOST is not 127.0.0.1: open http://<ip>:8000/login?token=<value> once on the tablet.
# NAV_ACCESS_TOKEN=change-me-to-a-long-random-string

# Max upload size per file (MB)
NAV_MAX_UPLOAD_MB=200

# Optional external provider (disabled until you also consent in Settings):
# ANTHROPIC_API_KEY=
# Optional key for an OpenAI-compatible server, if it needs one:
# OPENAI_COMPAT_API_KEY=
