# ===== قاعدة البيانات (Postgres) =====
# اتصال التطبيق بدور nav_app (يخضع لصلاحيات RLS). هذا فقط ما يوضع في Netlify.
DATABASE_URL=postgres://nav_app:CHANGE_ME@localhost:5432/nav_dev
# اتصال المالك: للترحيل والاستيراد فقط من جهازك. لا تضعيه في Netlify.
DATABASE_URL_OWNER=postgres://nav_owner:CHANGE_ME@localhost:5432/nav_dev
# true عند استخدام قاعدة بيانات مُدارة (Neon/Supabase)
DATABASE_SSL=false

# ===== الدخول =====
# سلسلة عشوائية طويلة: openssl rand -base64 32
BETTER_AUTH_SECRET=
# رابط الموقع الكامل، مثل https://navcoaching.com أو رابط Preview
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== البريد (Resend) — مطلوب لإرسال رمز الدخول في الإنتاج =====
RESEND_API_KEY=
# مثل: Nav Coaching <no-reply@navcoaching.com> (بعد توثيق الدومين في Resend)
MAIL_FROM=
# بريد المدربة لتنبيهات الطلبات الجديدة والإيصالات (بدون بيانات صحية)
COACH_NOTIFY_EMAIL=

# ===== تخزين الملفات =====
# local (للتطوير) أو netlify (Netlify Blobs — خاص وغير عام)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=.data/uploads

# ===== بوابة الدفع (غير مفعّلة) =====
# تبقى فارغة حتى اختيار المزود والموافقة. الموقع يعمل بالتحويل البنكي فقط.
PAYMENT_GATEWAY=
