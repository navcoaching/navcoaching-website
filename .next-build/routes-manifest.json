{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/ar",
      "destination": "/",
      "statusCode": 308,
      "regex": "^(?!/_next)/ar(?:/)?$"
    },
    {
      "source": "/ar/:path*",
      "destination": "/:path*",
      "statusCode": 308,
      "regex": "^(?!/_next)/ar(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/en/:seg(account|login|checkout|admin|install)",
      "destination": "/:seg",
      "statusCode": 307,
      "regex": "^(?!/_next)/en(?:/(account|login|checkout|admin|install))(?:/)?$"
    },
    {
      "source": "/en/:seg(account|login|checkout|admin)/:path*",
      "destination": "/:seg/:path*",
      "statusCode": 307,
      "regex": "^(?!/_next)/en(?:/(account|login|checkout|admin))(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
