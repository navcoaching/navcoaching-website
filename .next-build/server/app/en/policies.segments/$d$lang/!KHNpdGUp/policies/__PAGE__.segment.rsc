c:["$","li","3",{"children":"Payment is by direct bank transfer to the establishment’s account. The site never asks for or stores bank or card details. The transfer receipt is used only to confirm your order and is kept in private storage that only you and the coach can open."}]
d:["$","li","4",{"children":"We do not sell your data or share it for marketing. Your results or photos are never published without your explicit consent."}]
e:["$","li","5",{"children":"You can request a copy of your data, its deletion, or withdraw consent to publishing by messaging us on WhatsApp."}]
f:["$","li","6",{"children":"Analytics: we use Google Analytics on the public pages only, and only after you accept the banner on your first visit; declining means the visit is not measured. It never runs inside your account or on order, payment, or program pages, is never linked to your health or personal data, and is not used for advertising. Analytics data is processed by Google and is largely anonymised (IP masked, no personalised-ads features). Clearing the site data in your browser withdraws consent and shows the banner again."}]
10:["$","article","reviews",{"id":"reviews","className":"card","children":[["$","h2",null,{"style":{"fontSize":24,"marginBottom":14},"children":"Reviews policy"}],["$","div",null,{"className":"rich","children":[["$","ul","0",{"children":[["$","li","0",{"children":"Only trainees who bought a service and actually started it can write a review: one review per order."}],["$","li","1",{"children":"Every review is checked before it appears publicly, and its text is never edited."}],["$","li","2",{"children":"How your name appears is your choice: full name, first name only, or no name. Consent to publish is separate and optional."}],["$","li","3",{"children":"Reviews containing phone numbers, emails, links, private health details, or abuse of any person are not published."}],["$","li","4",{"children":"The coach may reply to a review, or hide a review that breaks this policy and record the reason."}],["$","li","5",{"children":"You can ask for your review to be hidden at any time by messaging us on WhatsApp."}]]}]]}]]}]
