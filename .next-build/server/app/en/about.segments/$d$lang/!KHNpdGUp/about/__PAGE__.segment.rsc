b:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$4","c",{"children":[["$","div",null,{"className":"pub","children":[["$","section",null,{"className":"page-hero","children":["$","div",null,{"className":"wrap about-hero","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"About the coach"}],["$","h1",null,{"style":{"fontSize":"clamp(32px,6vw,56px)","marginTop":12},"children":"Coach Sara | Nav"}],["$","p",null,{"className":"lead","children":"Certified personal trainer, coaching since 2017. I help you build a clear training and nutrition routine that fits your goal, time, and level, with weekly follow-up that keeps you going and progressing."}]]}],["$","figure",null,{"className":"about-photo","children":["$","img",null,{"src":"/brand/coach-sara.webp","alt":"Coach Sara | Nav","fetchPriority":"high"}]}]]}]}],["$","section",null,{"className":"section","children":["$","div",null,{"className":"wrap prose reveal","children":[["$","span",null,{"className":"eyebrow","children":"My story"}],["$","h2",null,{"children":"I became the person I once needed"}],[["$","p","Before I became a coach, I was a trainee tired of experiments. I subscribed with coaches abroad and never found anyone who explained the exercises properly or cared about my goals.",{"children":"Before I became a coach, I was a trainee tired of experiments. I subscribed with coaches abroad and never found anyone who explained the exercises properly or cared about my goals."}],["$","p","Then I trained with Coach Sahar Alharthi. She changed how I saw training and inspired me to become a coach, and to this day I thank her for everything she taught me. That is when I decided to be the person I had needed.",{"children":"Then I trained with Coach Sahar Alharthi. She changed how I saw training and inspired me to become a coach, and to this day I thank her for everything she taught me. That is when I decided to be the person I had needed."}],["$","p","Sport has been part of me from early on: I played basketball and captained the team at Imam Abdulrahman Bin Faisal University, and I competed professionally in esports. I started coaching in 2017 with basketball, worked as an assistant coach at the university club, and then coached at Pure Gym, Gymnation, Fitness Lounge, and private clubs.",{"children":"Sport has been part of me from early on: I played basketball and captained the team at Imam Abdulrahman Bin Faisal University, and I competed professionally in esports. I started coaching in 2017 with basketball, worked as an assistant coach at the university club, and then coached at Pure Gym, Gymnation, Fitness Lounge, and private clubs."}]]]}]}],["$","section",null,{"className":"section white","children":["$","div",null,{"className":"wrap","children":[["$","div",null,{"className":"sec-head reveal","children":[["$","span",null,{"className":"eyebrow","children":"My approach"}],["$","h2",null,{"children":"What makes training with me different?"}]]}],["$","div",null,{"className":"grid g4","children":[["$","div","Your plan explained on video",{"className":"card feature reveal","style":{"--d":"0ms"},"children":[["$","h3",null,{"children":"Your plan explained on video"}],["$","p",null,{"className":"muted","children":"I do not send a plan and leave it there. I walk through it with you in a video explaining everything, so you start with full understanding: what we do and why."}]]}],["$","div","No deprivation",{"className":"card feature reveal","style":{"--d":"80ms"},"children":[["$","h3",null,{"children":"No deprivation"}],["$","p",null,{"className":"muted","children":"I never use restrictive diets. Your plan fits your life, not a list of banned foods."}]]}],"$Lc","$Ld"]}]]}]}],"$Le","$Lf","$L10"]}],["$L11"],"$L12"]}],"p":"$@13","v":null,"s":"$a"}}]]
