c:["$","div",null,{"className":"pub","children":[["$","section",null,{"className":"page-hero","children":["$","div",null,{"className":"wrap about-hero","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"عن المدربة"}],["$","h1",null,{"style":{"fontSize":"clamp(32px,6vw,56px)","marginTop":12},"children":"الكوتش ساره | ناڤ"}],["$","p",null,{"className":"lead","children":"مدربة شخصية معتمدة، أدرب منذ 2017. أساعدك تبني روتين تدريب وتغذية واضح يناسب هدفك ووقتك ومستواك، مع متابعة أسبوعية تساعدك تستمر وتتقدم."}]]}],["$","figure",null,{"className":"about-photo","children":["$","img",null,{"src":"/brand/coach-sara.webp","alt":"الكوتش ساره | ناڤ","fetchPriority":"high"}]}]]}]}],["$","section",null,{"className":"section","children":["$","div",null,{"className":"wrap prose reveal","children":[["$","span",null,{"className":"eyebrow","children":"قصتي"}],["$","h2",null,{"children":"صرت الشخص اللي كنت أحتاجه"}],[["$","p","قبل ما أصير مدربة، كنت متدربة تعبت من التجارب. اشتركت مع مدربات أجانب، وما لقيت أحد يشرح لي التمرين صح أو يهتم بأهدافي.",{"children":"قبل ما أصير مدربة، كنت متدربة تعبت من التجارب. اشتركت مع مدربات أجانب، وما لقيت أحد يشرح لي التمرين صح أو يهتم بأهدافي."}],["$","p","لين اشتركت مع الكوتش سحر الحارثي. غيّرت نظرتي للتمرين، وحفّزتني أصير كوتش، وإلى اليوم أشكرها على كل اللي علمتني إياه. من هنا قررت أكون الشخص اللي احتجته أنا.",{"children":"لين اشتركت مع الكوتش سحر الحارثي. غيّرت نظرتي للتمرين، وحفّزتني أصير كوتش، وإلى اليوم أشكرها على كل اللي علمتني إياه. من هنا قررت أكون الشخص اللي احتجته أنا."}],["$","p","والرياضة جزء مني من بدري: لعبت كرة السلة وكنت كابتن فريق السلة في جامعة الإمام عبدالرحمن بن فيصل، ولعبت باحتراف في الرياضات الإلكترونية. بدأت التدريب في 2017 مع كرة السلة، واشتغلت مساعد مدرب في نادي الجامعة، وبعدها دربت في بيور جم وجمنيشن وفتنس لاونج ونوادي خاصة.",{"children":"والرياضة جزء مني من بدري: لعبت كرة السلة وكنت كابتن فريق السلة في جامعة الإمام عبدالرحمن بن فيصل، ولعبت باحتراف في الرياضات الإلكترونية. بدأت التدريب في 2017 مع كرة السلة، واشتغلت مساعد مدرب في نادي الجامعة، وبعدها دربت في بيور جم وجمنيشن وفتنس لاونج ونوادي خاصة."}]]]}]}],["$","section",null,{"className":"section white","children":["$","div",null,{"className":"wrap","children":[["$","div",null,{"className":"sec-head reveal","children":[["$","span",null,{"className":"eyebrow","children":"أسلوبي"}],["$","h2",null,{"children":"وش يميز التدريب معي؟"}]]}],["$","div",null,{"className":"grid g4","children":[["$","div","جدولك مشروح بالفيديو",{"className":"card feature reveal","style":{"--d":"0ms"},"children":[["$","h3",null,{"children":"جدولك مشروح بالفيديو"}],["$","p",null,{"className":"muted","children":"ما أرسل جدول وأترك المتابعة. أراجعه معك بمقطع فيديو أشرح فيه كل شي، عشان تكون البداية بفهم كامل: وش نسوي وليش."}]]}],["$","div","بدون حرمان",{"className":"card feature reveal","style":{"--d":"80ms"},"children":[["$","h3",null,{"children":"بدون حرمان"}],["$","p",null,{"className":"muted","children":"ما أمشي على أنظمة الحرمان أبداً. خطتك تناسب حياتك، مو قائمة ممنوعات."}]]}],["$","div","متابعة جادة وخطة واقعية",{"className":"card feature reveal","style":{"--d":"160ms"},"children":[["$","h3",null,{"children":"متابعة جادة وخطة واقعية"}],["$","p",null,{"className":"muted","children":"أتابعك كل أسبوع وأهتم بالتزامك، وأعدّل خطتك حسب تقدمك وظروفك."}]]}],["$","div","أعلّمك، مو بس أدربك",{"className":"card feature reveal","style":{"--d":"240ms"},"children":[["$","h3",null,{"children":"أعلّمك، مو بس أدربك"}],["$","p",null,{"className":"muted","children":"حب تعليم الناس معي من الصغر. اللي أعرفه ما أبخل فيه، علمياً ونفسياً، وما أوقف عن البحث والتعلم عشان أتطور وأطورك معي."}]]}]]}]]}]}],["$","section",null,{"className":"section","children":["$","div",null,{"className":"wrap prose reveal","children":[["$","span",null,{"className":"eyebrow","children":"لمن يناسب؟"}],["$","h2",null,{"children":"أكثر شخص أفرق معه"}],[["$","p","كل من يؤمن إن التمرين أسلوب حياة، مو تمرين لشكل مؤقت أو لفترة الصيف بس.",{"children":"كل من يؤمن إن التمرين أسلوب