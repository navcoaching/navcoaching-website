{
  "expo": {
    "name": "Nav Coaching",
    "slug": "navcoaching",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.navcoaching.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07142a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.navcoaching.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "forcesRTL": true
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول للصور حتى ترفع صورة إيصال التحويل.",
          "cameraPermission": "نحتاج الكاميرا حتى تصوّر إيصال التحويل.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#07142a",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "navcoaching",
    "experiments": {
      "typedRoutes": true
    }
  }
}
